{
  "name": "open-road",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser open-world driving sandbox: realistic car physics and crash deformation (Three.js + Rapier).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "models": "node scripts/build-models.mjs",
    "models:procedural": "blender -b --factory-startup -P art/build_cars.py && node scripts/optimize-models.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "lil-gui": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@eslint/js": "^9.39.5",
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
